# Timber Online 2.0 — omgevingsvariabelen (alleen veldnamen; vul waarden in .env.local of in Vercel)

# Algemeen
APP_URL=                          # bv. https://timberonline.timberservices.nl
NEXT_PUBLIC_SHOP_MODE=test        # "live" verbergt de testbalk; pas na livegangcontrole

# Supabase (project TIMBERONLINE)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # publieke sleutel; alleen voor beheerlogin
SUPABASE_SERVICE_ROLE_KEY=        # geheim; alleen server
DATA_DRIVER=supabase              # "pg" alleen lokaal met DATABASE_URL
DATABASE_URL=                     # alleen lokaal/back-up; niet nodig op Vercel
STORAGE_DRIVER=supabase           # "local" alleen lokaal

# Stripe (testmodus tot livegang)
STRIPE_SECRET_KEY=                # sk_test_... ; live sleutels worden geweigerd zolang STRIPE_LIVE_ENABLED niet "true" is
STRIPE_WEBHOOK_SECRET=            # whsec_...
STRIPE_LIVE_ENABLED=false
STRIPE_PAYMENT_METHOD_TYPES=      # optioneel filter, bv. "ideal,klarna"; leeg = wat in Stripe aan staat

# E-mail (Resend)
MAIL_MODE=simulated               # "resend" om echt te versturen
RESEND_API_KEY=
MAIL_FROM=                        # bv. Timber Online <bestellingen@timberonline.timberservices.nl>
MAIL_REPLY_TO=
MAIL_TEST_RECIPIENT=              # testmodus: alle mail naar dit gecontroleerde adres

# bol Retailer API
BOL_MODE=simulated                # "live" pas na controle aanbiedingen en beginstanden
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# Vervoerders
CARRIER_MODE=simulated            # live DHL/PostNL nog niet geactiveerd

# AI-prijsassistent
AI_PROVIDER=rule-based            # "openai" na akkoord over provider en budget
OPENAI_API_KEY=
OPENAI_MODEL=

# Cron (Vercel stuurt Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Alleen lokale ontwikkeling: beheer zonder login (werkt nooit in een productiebuild)
ADMIN_DEV_BYPASS=
